{
  "name": "ymusic-server",
  "version": "1.0.0",
  "private": true,
  "description": "Remote config endpoint for YMusic: feature flags and update availability.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:local": "node --env-file=dev.env --import tsx src/index.ts",
    "test:local": "node --env-file=dev.env node_modules/.bin/vitest run test/ingest.test.ts",
    "start:dashboard": "node dist/dashboard/index.js",
    "dev:dashboard": "node --env-file=dashboard.env --import tsx src/dashboard/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "fastify": "^5.4.0",
    "pg": "^8.23.0",
    "typescript": "^5.8.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
